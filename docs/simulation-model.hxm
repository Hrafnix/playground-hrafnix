<?xml version="1.0" encoding="UTF-8"?>
<model file-version="1" minimum-version="1.0" built-version="1.0" name="example">
    <model-settings>
        <setting key="start-time" value="0"/>
        <setting key="end-time" value="60"/>
        <setting key="time-step" value="0.1"/>
    </model-settings>

    <parameters description="Model parameters">
        <item key="p_target_temperature" type="number" description="Target temperature"
              default="22" value="22"/>
    </parameters>
    <variables description="Model variables">
        <item key="v_elapsed_time" type="number" description="Elapsed time" default="0" value="0"/>
    </variables>

    <components>
        <component-file
                id="temperature_sensor"
                component-version="1"
                source-blake3="1b6e5f2b2d36a4e741970a6a0cf7b174ee0b31d469a86b55cedb89a5022edadd"
                package="hrafnix.sensors@1.0"
                path="temperature_sensor.hrc">
            <location x="150" y="0" width="120" height="60"/>
            <icon path="icons/temperature-sensor.svg"/>
            <parameters description="Temperature sensor parameters">
                <item key="p_unit" type="unit" description="Unit" unit-family="temperature"
                      default="u_temperature_celsius" value="u_temperature_celsius"/>
            </parameters>
            <variables description="Temperature sensor variables"/>
            <ports>
                <port id="temperature" type="output">
                    <location x="1.0" y="0.5"/>
                </port>
            </ports>
        </component-file>
        <component-file id="heater"
                component-version="1"
                source-blake3="b9e1d4891d04eebd9cab3c4626fd1f70a5f5e84ddb16e6404d41e7018bfe73e5"
                path="heater.hrc">
            <location x="320" y="0" width="120" height="60"/>
            <icon path="icons/heater.svg"/>
            <parameters description="Heater parameters">
                <item key="p_maximum_power" type="number" description="Maximum power"
                      default="2000" value="2000"/>
            </parameters>
            <variables description="Heater variables">
                <item key="v_is_active" type="boolean" description="Is active" default="false" value="false"/>
            </variables>
            <ports>
                <port id="temperature_input" type="input">
                    <location x="0.0" y="0.5"/>
                </port>
            </ports>
        </component-file>
        <component id="simulation_clock" type="clock" version="1">
            <location x="0" y="0" width="100" height="50"/>
            <parameters description="Clock parameters"/>
            <variables description="Clock variables"/>
            <ports>
                <port id="time" type="output">
                    <location x="1.0" y="0.5"/>
                </port>
            </ports>
        </component>
    </components>

    <connections>
        <connection
                from-component="simulation_clock"
                from-port="time"
                to-component="heater"
                to-port="temperature_input"
                style="solid">
            <line>
                <midpoint x="210" y="25"/>
            </line>
        </connection>
        <connection
                from-component="temperature_sensor"
                from-port="temperature"
                to-component="heater"
                to-port="temperature_input"
                style="solid">
            <line>
                <midpoint x="295" y="30"/>
            </line>
        </connection>
    </connections>
</model>
