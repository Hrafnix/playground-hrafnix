<?xml version="1.0" encoding="UTF-8"?>
<component file-version="1"
           minimum-version="1.0"
           recommended-version="1.0"
           version="1" name="heater" language="en"
           icon="heater.svg" width="120" height="60">
    <metadata>
        <author>Hrafnix</author>
        <description>A heater component</description>
    </metadata>

    <parameters description="Heater parameters">
        <item key="p_target_temperature" type="number" description="Target temperature" default="22"/>
    </parameters>
    <variables description="Heater variables">
        <item key="v_elapsed_time" type="number" description="Elapsed time" default="0"/>
    </variables>
    <ports>
        <port id="temperature" type="output">
            <location x="1.0" y="0.5"/>
        </port>
    </ports>

     <background-decorations>
            <decoration id="background" type="rectangle">
                <location x="0" y="0" width="500" height="200"/>
                <style fill-color="#f0f0f0" stroke-color="#000000" stroke-width="1"/>
            </decoration>
            <decoration id="sensor_region" type="rounded-rectangle">
                <location x="140" y="0" width="140" height="70"/>
                <style fill-color="#e8f4ff" stroke-color="#93c5fd" stroke-width="1" corner-radius="8"/>
            </decoration>
            <decoration id="heater_frame" type="frame">
                <location x="310" y="0" width="140" height="70"/>
                <style stroke-color="#f97316" stroke-width="2"/>
            </decoration>
        </background-decorations>

        <foreground-decorations>
            <decoration id="title" type="text">
                <location x="10" y="10" width="480" height="30"/>
                <style font-size="20" font-weight="bold" text-color="#000000"/>
                <text>Heater Simulation Model</text>
            </decoration>
            <decoration id="model_icon" type="image">
                <location x="455" y="10" width="30" height="30"/>
                <image path="heater.svg" fit="contain"/>
            </decoration>
        </foreground-decorations>

    <components>
        <component-file
                id="temperature_sensor"
                version="1"
                source-hash="blake3:1b6e5f2b2d36a4e741970a6a0cf7b174ee0b31d469a86b55cedb89a5022edadd"
                package="hrafnix.sensors"
                path="temperature_sensor.hxc">
            <location x="150" y="0" width="120" height="60"/>
            <icon path="temperature-sensor.svg"/>
            <parameters>
                <item key="p_unit" type="unit" description="Unit" unit-family="temperature"
                      default="u_temperature_celsius" value="u_temperature_celsius"/>
            </parameters>
            <ports>
                <port id="temperature" type="output">
                    <location x="1.0" y="0.5"/>
                </port>
            </ports>
        </component-file>
        <component-file id="heater"
                version="1"
                source-hash="blake3:b9e1d4891d04eebd9cab3c4626fd1f70a5f5e84ddb16e6404d41e7018bfe73e5"
                path="heater.hxc">
            <location x="320" y="0" width="120" height="60"/>
            <icon path="heater.svg"/>
            <parameters>
                <item key="p_maximum_power" type="number" description="Maximum power"
                      default="2000" value="2000"/>
            </parameters>
            <ports>
                <port id="temperature_input" type="input">
                    <location x="0.0" y="0.5"/>
                </port>
            </ports>
        </component-file>
        <component id="simulation_clock" type="builtin.clock" version="1">
            <location x="0" y="0" width="100" height="50"/>
            <parameters/>
            <ports>
                <port id="time" type="output">
                    <location x="1.0" y="0.5"/>
                </port>
            </ports>
        </component>
    </components>

    <connections>
        <connection
                from-component="simulation_clock"
                from-port="time"
                to-component="heater"
                to-port="temperature_input"
                style="solid">
            <line>
                <midpoint x="210" y="25"/>
            </line>
        </connection>
        <connection
                from-component="temperature_sensor"
                from-port="temperature"
                to-component="heater"
                to-port="temperature_input"
                style="solid">
            <line>
                <midpoint x="295" y="30"/>
            </line>
        </connection>
    </connections>

    <translations>
        <translation key="Target temperature" language="en">
            <item language="es" value="Temperatura objetivo"/>
            <item language="fr" value="Température cible"/>
            <item language="de" value="Zieltemperatur"/>
        </translation>
    </translations>
</component>
